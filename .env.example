# llmterm .env template.
# (Same output as `llmterm --show-env-template`, for installs where this
# file is not on disk. API keys are NEVER stored by llmterm.)
# Copy to `.env` in the directory where you run `llmterm`, uncomment the
# lines you need, and fill in your keys — or set them in your shell instead.

# UnSloth-Studio (optional; only when the server requires auth)
#UNSLOTH_STUDIO_API_KEY=your-key

# OpenAI (required)
#OPENAI_API_KEY=your-key

# Meta-AI (required)
#META_API_KEY=your-key

# Baseten (required)
#BASETEN_API_KEY=your-key

# Optional override for any endpoint base URL (URLs only, never keys).
#LLMTERM_BASE_URL=https://your-deployment.example.com/v1
